[Unit]
Description=MoonShield Alpha Debug SSH bootstrap
After=local-fs.target systemd-remount-fs.service
Before=moonshield-iso-firstboot.service
ConditionPathExists=/etc/moonshield/alpha-debug

[Service]
Type=oneshot
ExecStart=/usr/local/lib/moonshield-iso/moonshield-alpha-debug-ssh-bootstrap.sh bootstrap
StandardOutput=journal
StandardError=journal
UMask=0077

[Install]
WantedBy=multi-user.target
