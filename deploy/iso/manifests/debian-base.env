# Fixed Debian 13 point release; never resolve a moving "current" URL at build time.
DEBIAN_ISO_VERSION=13.7.0
DEBIAN_ISO_ARCH=amd64
DEBIAN_ISO_FILENAME=debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_URL=https://cdimage.debian.org/debian-cd/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_SHA256=REQUIRED_BEFORE_BUILD
# Verify SHA256SUMS against its Debian signing key before replacing the required value.
DEBIAN_ISO_CHECKSUM_URL=https://cdimage.debian.org/debian-cd/13.7.0/amd64/iso-cd/SHA256SUMS
