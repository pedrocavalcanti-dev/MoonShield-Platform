# Do not fill these with guesses. Installer/download builder refuses REQUIRED values.
ADGUARD_URL=https://github.com/AdguardTeam/AdGuardHome/releases/download/v0.107.79/AdGuardHome_linux_amd64.tar.gz
ADGUARD_SHA256=c48f4a43000665484c5ec28177de11a004759b620dae8f77b2aabefc9ef3687f

# Optional operator-provided corporate CA fingerprint; compared when set.
# A file supplied by operator/media may be installed only after X.509 validation.
CORPORATE_CA_SHA256=REQUIRED_BEFORE_ISO

# Appliance TLS is separate from corporate download trust. Supply through existing
# /etc/moonshield/tls provisioning; installer does not create a second PKI.
APPLIANCE_TLS_CERT=REQUIRED_BEFORE_ISO
APPLIANCE_TLS_KEY=REQUIRED_BEFORE_ISO
