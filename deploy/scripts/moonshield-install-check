#!/usr/bin/env bash
set -Eeuo pipefail

PASS=0
WARN=0
FAIL=0

pass() { printf '[PASS] %s\n' "$1"; PASS=$((PASS + 1)); }
warn() { printf '[WARN] %s\n' "$1"; WARN=$((WARN + 1)); }
fail() { printf '[FAIL] %s\n' "$1"; FAIL=$((FAIL + 1)); }

check_service() {
  local service="$1" required="$2"
  if systemctl is-active --quiet "$service"; then pass "$service ativo"; elif [[ "$required" == yes ]]; then fail "$service inativo"; else warn "$service inativo"; fi
  if ! systemctl list-unit-files --no-legend "$service" 2>/dev/null | grep -q "$service"; then
    [[ "$required" == yes ]] && fail "unit $service não instalado" || warn "unit $service não instalado"
  fi
}

check_loopback_listener() {
  local port="$1" label="$2" output
  output="$(ss -H -ltn "sport = :$port" 2>/dev/null || true)"
  if [[ -z "$output" ]]; then fail "$label sem listener TCP na porta $port"; return; fi
  if printf '%s\n' "$output" | awk '{print $4}' | grep -Eq '^(0\.0\.0\.0|\*|\[::\]):'; then
    fail "$label exposto em endereço wildcard na porta $port"
  elif printf '%s\n' "$output" | awk '{print $4}' | grep -Eq '^(127\.0\.0\.1|\[::1\]):'; then
    pass "$label restrito a loopback na porta $port"
  else
    fail "$label escutando em endereço inesperado na porta $port"
  fi
}

if [[ -x /opt/moonshield/venv/bin/python && -f /opt/moonshield/source/MoonShield/gerenciar.py ]]; then
  if command -v runuser >/dev/null 2>&1; then
    if (cd /opt/moonshield/source/MoonShield && runuser -u moonshield -- /opt/moonshield/venv/bin/python gerenciar.py check >/dev/null 2>&1); then pass "Django check como moonshield"; else fail "Django check como moonshield"; fi
  else
    fail "runuser ausente; Django não foi validado como usuário do serviço"
  fi
else
  fail "código/venv Django ausente"
fi

command -v pg_isready >/dev/null 2>&1 && pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1 && pass "PostgreSQL pronto em loopback" || fail "PostgreSQL indisponível em 127.0.0.1:5432"
check_service nginx.service yes
check_service moonshield-web.service yes
check_service moonshield-agent.service yes
check_service moonshield-suricata-monitor.service yes
check_service moonshield-suricata-worker.service yes
check_service moonshield-firewall-worker.service yes
check_service NetworkManager.service no
check_service nftables.service no
check_service suricata.service yes
check_service AdGuardHome.service no
check_service postgresql.service yes

if command -v suricata >/dev/null 2>&1 && [[ -s /etc/suricata/suricata.yaml ]]; then
  if suricata -T -c /etc/suricata/suricata.yaml >/dev/null 2>&1; then
    pass 'Suricata config test aprovado'
  else
    fail 'Suricata config test falhou'
  fi
else
  fail 'binário ou configuração Suricata ausente'
fi
if [[ -s /var/lib/suricata/rules/suricata.rules && -s /var/lib/suricata/rules/moonshield/ms.rules ]]; then
  pass 'rulesets Suricata Debian e MoonShield presentes'
else
  fail 'rulesets Suricata offline ausentes'
fi

check_loopback_listener 8000 Gunicorn
check_loopback_listener 5432 PostgreSQL
if systemctl is-active --quiet AdGuardHome.service; then
  check_loopback_listener 3000 'AdGuard Admin'
else
  warn 'AdGuard aguardando topologia DNS ser configurada no onboarding'
fi

ss -H -ltn '( sport = :80 or sport = :443 )' 2>/dev/null | grep -q . && pass 'Nginx listener em 80/443' || fail 'Nginx sem listener HTTP/HTTPS'
if find /etc/nginx/sites-enabled -mindepth 1 -maxdepth 1 -name '*.backup.*' -print -quit | grep -q .; then
  fail 'backup de vhost encontrado em /etc/nginx/sites-enabled'
else
  pass 'nenhum backup de vhost dentro de /etc/nginx/sites-enabled'
fi
if systemctl is-active --quiet AdGuardHome.service; then
  ss -H -lun '( sport = :53 )' 2>/dev/null | grep -q . && pass 'DNS UDP/53 ativo' || fail 'DNS UDP/53 indisponível'
  ss -H -ltn '( sport = :53 )' 2>/dev/null | grep -q . && pass 'DNS TCP/53 ativo' || fail 'DNS TCP/53 indisponível'
else
  warn 'DNS UDP/53 pendente da topologia do onboarding'
  warn 'DNS TCP/53 pendente da topologia do onboarding'
fi

if curl --silent --show-error --max-time 5 --output /dev/null http://127.0.0.1/ 2>/dev/null; then pass 'HTTP local via Nginx'; else fail 'HTTP local via Nginx'; fi
for path in /etc/moonshield /etc/moonshield/secrets /var/lib/moonshield /var/lib/moonshield/firewall /var/lib/moonshield/rede /var/lib/moonshield/suricata /var/log/moonshield /var/log/moonshield/app /run/moonshield; do
  [[ -d "$path" ]] && pass "diretório $path" || fail "diretório $path ausente"
done
mode="$(stat -c '%a:%U:%G' /var/log/moonshield/app 2>/dev/null || true)"
[[ "$mode" == 750:moonshield:moonshield ]] && pass 'permissões do diretório de logs Django' || fail 'logs Django devem ser moonshield:moonshield 0750'

[[ -f /opt/moonshield/console/moonshield_console.py ]] && pass 'console instalada' || fail 'console instalada ausente'
[[ -x /usr/local/sbin/moonshield-install-check ]] && pass 'healthcheck gerenciado instalado' || fail 'healthcheck gerenciado ausente'
if systemctl is-enabled --quiet moonshield-console.service; then pass 'console habilitada'; else fail 'console não habilitada'; fi
if systemctl is-active --quiet moonshield-console.service; then
  pass 'console ativa'
else
  warn 'console habilitada para iniciar no próximo boot (TTY1 não interrompida durante instalação)'
fi
tty_path="$(systemctl show --property=TTYPath --value moonshield-console.service 2>/dev/null || true)"
tty_owner="$(stat -c '%U:%G' /dev/tty1 2>/dev/null || true)"
if [[ -c /dev/tty1 && "$tty_path" == /dev/tty1 && "$tty_owner" == root:tty ]] \
  && grep -Fxq 'StandardInput=tty' /etc/systemd/system/moonshield-console.service \
  && grep -Fxq 'User=root' /etc/systemd/system/moonshield-console.service \
  && grep -Fxq 'ExecStart=/opt/moonshield/venv/bin/python /opt/moonshield/console/moonshield_console.py' /etc/systemd/system/moonshield-console.service; then
  pass 'TTY1 ownership/configuração da console'
else
  fail 'TTY1 ausente ou ownership/configuração da console incorreta'
fi
if [[ -f /etc/moonshield/support/maintenance_public.pem && ! -L /etc/moonshield/support/maintenance_public.pem ]]; then
  key_mode="$(stat -c '%a:%U:%G' /etc/moonshield/support/maintenance_public.pem 2>/dev/null || true)"
  if [[ "$key_mode" == 644:root:root ]] \
    && openssl pkey -pubin -in /etc/moonshield/support/maintenance_public.pem -text -noout 2>/dev/null | grep -Eq 'Public-Key: \((3072|[4-9][0-9]{3,}|[1-9][0-9]{4,}) bit\)'; then
    pass 'chave pública de manutenção RSA >= 3072 bits, root:root 0644'
  else
    fail 'chave pública de manutenção inválida ou menor que 3072 bits'
  fi
elif [[ -f /etc/moonshield/final-iso ]]; then
  fail 'chave pública de manutenção obrigatória ausente no modo final ISO'
else
  warn 'MAINTENANCE_PUBLIC_KEY=REQUIRED_BEFORE_ISO'
fi
if [[ -f /etc/moonshield/final-iso ]]; then
  for tty in 2 3 4 5 6; do
    [[ -L "/etc/systemd/system/getty@tty${tty}.service" && "$(readlink "/etc/systemd/system/getty@tty${tty}.service")" == /dev/null ]] \
      && pass "getty TTY$tty mascarado" || fail "getty TTY$tty não está mascarado no modo final ISO"
  done
  if systemctl is-enabled --quiet ssh.service 2>/dev/null || systemctl is-enabled --quiet ssh.socket 2>/dev/null \
    || systemctl is-active --quiet ssh.service 2>/dev/null || systemctl is-active --quiet ssh.socket 2>/dev/null; then
    fail 'SSH habilitado no modo final ISO'
  else
    pass 'SSH desabilitado no modo final ISO'
  fi
fi

if [[ -f /etc/moonshield/database.env ]]; then
  mode="$(stat -c '%a:%U:%G' /etc/moonshield/database.env 2>/dev/null || true)"
  [[ "$mode" == 640:root:moonshield ]] && pass 'permissões de database.env' || fail 'database.env deve ser root:moonshield 0640'
else
  fail 'database.env ausente'
fi
if [[ -f /etc/moonshield/secrets/django_secret_key ]]; then
  mode="$(stat -c '%a:%U:%G' /etc/moonshield/secrets/django_secret_key 2>/dev/null || true)"
  [[ "$mode" == 640:root:moonshield ]] && pass 'permissões da SECRET_KEY' || fail 'SECRET_KEY deve ser root:moonshield 0640'
else
  fail 'SECRET_KEY de appliance ausente'
fi

printf '\nResultado: %d PASS, %d WARN, %d FAIL\n' "$PASS" "$WARN" "$FAIL"
(( FAIL == 0 ))
